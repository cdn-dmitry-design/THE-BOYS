<!-- Горизонтальный скролл -->
<style>
.history-scroll-zone{
  position:relative!important;
  width:100%!important;
  max-width:100%!important;
  overflow-x:clip!important;
  background:#FDF7EE!important
}
.history-scroll-zone #rec4123004701{
  width:100%!important;
  height:var(--history-vh)!important;
  min-height:var(--history-vh)!important;
  overflow:visible!important;
  background:#FDF7EE!important
}
.history-scroll-zone #rec4123004701 .t396__artboard,
.history-scroll-zone #rec4123004701 .t396__carrier,
.history-scroll-zone #rec4123004701 .t396__filter{
  height:var(--history-vh)!important;
  min-height:var(--history-vh)!important;
  background:#FDF7EE!important
}
.history-scroll-zone.is-before #rec4123004701{
  position:absolute!important;
  top:0!important;
  left:0!important;
  z-index:50!important
}
.history-scroll-zone.is-fixed #rec4123004701{
  position:fixed!important;
  top:0!important;
  left:0!important;
  z-index:50!important
}
.history-scroll-zone.is-after #rec4123004701{
  position:absolute!important;
  top:var(--history-release-top)!important;
  left:0!important;
  z-index:50!important
}
@media(max-width:960px){
  #rec4123004701 .t396__artboard>.tn-elem{
    translate:var(--history-mobile-x,0px) 0!important
  }
  #rec4123004701 .t396__artboard>.tn-elem.history-pin{
    translate:0 0!important
  }
}
</style>
<script>
document.addEventListener("DOMContentLoaded",function(){
  var rec=document.querySelector("#rec4123004701");
  if(!rec||window.__tbHistScroll)return;
  if(rec.parentElement&&rec.parentElement.classList.contains("history-scroll-zone"))return;
  window.__tbHistScroll=1;

  var ua=navigator.userAgent;
  var isSafari=/Safari/i.test(ua)&&!/Chrome|CriOS|Chromium|Edg|OPR|YaBrowser/i.test(ua);
  var isMac=/Macintosh/i.test(ua)&&navigator.maxTouchPoints<=1;
  var macSafari=isSafari&&isMac;
  var isIOS=/iP(hone|od|ad)/i.test(ua)||(/Macintosh/i.test(ua)&&navigator.maxTouchPoints>1);

  function getVH(){
    var h=window.innerHeight;
    if(macSafari&&window.visualViewport&&visualViewport.height)h=visualViewport.height;
    return Math.round(h);
  }

  /* На iPhone шире XR clientWidth/innerWidth/visualViewport расходятся — берём видимую ширину */
  function viewW(){
    var cw=document.documentElement.clientWidth||0;
    var iw=window.innerWidth||0;
    var vw=window.visualViewport&&visualViewport.width?visualViewport.width:0;
    var list=[cw,iw];
    if(vw>0)list.push(vw);
    var w=Math.min.apply(null,list.filter(function(n){return n>0;}));
    return Math.round(w)||320;
  }

  var zone=document.createElement("div");
  zone.className="history-scroll-zone is-before";
  rec.parentNode.insertBefore(zone,rec);
  zone.appendChild(rec);

  var travel=0,moveDistance=0,start=0,ticking=0,active=0,lastX=-1,mode="before";
  var mobile=viewW()<=960,vh=getVH(),lastW=viewW(),lastH=vh;
  var RIGHT_GAP=16,MOBILE_BOTTOM_GAP=120;

  document.documentElement.style.setProperty("--history-vh",vh+"px");

  function setX(x){
    x=0|x;
    if(x===lastX)return;
    lastX=x;
    if(mobile){
      rec.style.transform="none";
      rec.style.setProperty("--history-mobile-x",(-x)+"px");
    }else{
      rec.style.setProperty("--history-mobile-x","0px");
      rec.style.transform="translate3d("+(-x)+"px,0,0)";
    }
  }

  function setMode(nextMode){
    if(mode===nextMode)return;
    mode=nextMode;
    zone.className="history-scroll-zone is-"+nextMode;
  }

  function endEl(){return rec.querySelector(".history-end");}

  function safariScaledRight(el){
    if(!el)return 0;
    var parent=el.offsetParent;
    var parentLeft=parent?parent.getBoundingClientRect().left:0;
    var zoom=Number(getComputedStyle(el).zoom)||1;
    return parentLeft+(el.offsetLeft+el.offsetWidth)*zoom;
  }

  function fallbackRight(){
    var max=0;
    rec.querySelectorAll(".tn-elem").forEach(function(el){
      if(mobile&&el.classList.contains("history-pin"))return;
      var style=getComputedStyle(el);
      if(style.display==="none"||style.visibility==="hidden"||parseFloat(style.opacity)===0)return;
      var rect=el.getBoundingClientRect();
      if(rect.width>0&&rect.height>0)max=Math.max(max,rect.right);
    });
    return max;
  }

  function measureMobile(end){
    setX(0);void rec.offsetWidth;
    var before=end.getBoundingClientRect().right;
    setX(100);void rec.offsetWidth;
    var after=end.getBoundingClientRect().right;
    setX(0);void rec.offsetWidth;
    var ratio=Math.abs(before-after)/100;
    if(!ratio||!isFinite(ratio)||ratio<0.05)ratio=1;
    return{right:before,ratio:ratio};
  }

  function measure(){
    if(!mobile||macSafari)vh=getVH();
    document.documentElement.style.setProperty("--history-vh",vh+"px");
    lastX=-1;
    setMode("before");
    setX(0);
    void rec.offsetWidth;

    var target=viewW()-RIGHT_GAP;
    var end=endEl(),right=0,ratio=1;

    if(mobile&&end){
      var result=measureMobile(end);
      right=result.right;
      ratio=result.ratio;
      var visibleDistance=Math.max(0,right-target);
      moveDistance=visibleDistance/ratio;
      travel=visibleDistance;
    }else{
      if(end)right=(macSafari||isIOS)?safariScaledRight(end):end.getBoundingClientRect().right;
      else right=fallbackRight();
      moveDistance=Math.max(0,right-target);
      travel=moveDistance;
    }

    zone.style.height=(vh+travel+(mobile?MOBILE_BOTTOM_GAP:0))+"px";
    zone.style.setProperty("--history-release-top",travel+"px");
    start=zone.getBoundingClientRect().top+(scrollY||pageYOffset||0);
    update();
  }

  function update(){
    var y=scrollY||pageYOffset||0;
    var raw=Math.max(0,Math.min(travel,y-start));
    var move=travel>0?moveDistance*(raw/travel):0;
    if(y<start){setMode("before");setX(0);}
    else if(y<start+travel){setMode("fixed");setX(move);}
    else{setMode("after");setX(moveDistance);}
  }

  function onScroll(){
    if(!active||ticking)return;
    ticking=1;
    requestAnimationFrame(function(){update();ticking=0;});
  }

  function onResize(){
    var w=viewW();
    var widthChanged=Math.abs(w-lastW)>=5;
    if(w<=960&&!macSafari&&!widthChanged)return;
    var h=getVH();
    if(!widthChanged&&Math.abs(h-lastH)<5)return;
    lastW=w;lastH=h;mobile=w<=960;vh=h;
    document.documentElement.style.setProperty("--history-vh",vh+"px");
    clearTimeout(window.__historyResizeTimer);
    window.__historyResizeTimer=setTimeout(measure,150);
  }

  if(window.IntersectionObserver){
    var observer=new IntersectionObserver(function(entries){
      active=entries.some(function(entry){return entry.isIntersecting;})?1:0;
      if(active)update();
    },{rootMargin:"50% 0px 50% 0px"});
    observer.observe(zone);
  }else active=1;

  window.addEventListener("scroll",onScroll,{passive:true});
  window.addEventListener("resize",onResize,{passive:true});
  if(macSafari&&window.visualViewport)visualViewport.addEventListener("resize",onResize,{passive:true});
  if(isIOS&&window.visualViewport)visualViewport.addEventListener("resize",onResize,{passive:true});

  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(function(){setTimeout(measure,500);});
  else setTimeout(measure,800);
});
</script>
